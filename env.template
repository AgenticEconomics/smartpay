# SmartPay AP2 Environment Configuration Template
# Copy this file to .env and fill in your values
# cp env.template .env

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Google API Key - Required for Gemini AI models
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Logging configuration
LOG_LEVEL=INFO

# Debug mode
DEBUG=false

# Service ports (should match docker-compose.yml)
MERCHANT_AGENT_PORT=8001
CREDENTIALS_PROVIDER_PORT=8002
PAYMENT_PROCESSOR_PORT=8003
SHOPPING_AGENT_PORT=8080

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Python path (usually no need to change)
PYTHONPATH=/app/samples/python/src:/app

# Health check settings
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file: cp env.template .env
# 2. Edit .env and replace 'your_google_api_key_here' with your actual API key
# 3. Save the file
# 4. Run: make up (or ./docker-start.sh start)
#
# Your API key will be securely passed to all containers via Docker secrets.
